# Copy to .env and fill in to enable LIVE fetching from the Alpaca News/Market Data API.
# The pipeline runs fully OFFLINE from bundled fixtures without any of these set.

# Alpaca API credentials (https://alpaca.markets -> paper trading keys work for market data).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: override the market-data host (defaults to the Alpaca data API).
ALPACA_DATA_URL=

# Optional: override the local Parquet cache directory (defaults to ./data_cache).
FINBERT_NEWS_CACHE=
